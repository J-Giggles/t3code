# Per-worktree pod environment (copy to .generated/{slug}/.env — never commit secrets)

POD_SLUG=t3code-staging
TS_HOSTNAME=t3code-staging
INSTANCE_NAME=t3code-staging
CONVEX_DB_NAME=t3code_staging

# Ports (host-visible when LOCAL_ONLY=1 publishes ports on local-net)
PORT=3220
SITE_PROXY_PORT=3221
DASHBOARD_PORT=6792
POSTGRES_PORT=5433
WEB_PORT=6657
SERVER_PORT=14697
CDP_PORT=9232
CADDY_PORT=8080
NOVNC_PORT=6080

# Secrets — generate once per worktree
INSTANCE_SECRET=
POSTGRES_PASSWORD=

# Tailscale (omit for LOCAL_ONLY=1)
TS_AUTHKEY=
TS_EXTRA_ARGS=--ssh --accept-routes
TAILSCALE_SERVE=1

# URLs
CONVEX_CLOUD_ORIGIN=http://127.0.0.1:3220
CONVEX_SITE_ORIGIN=http://127.0.0.1:3221
POD_PUBLIC_BASE_URL=

# Worktree paths (host absolute paths)
WORKTREE_PATH=/home/you/code/t3code-local/t3code-staging
CODE_ROOT=/home/you/code
TEMPLATE_DIR=/home/you/code/t3code-local/infra/convex-docker/template

# local | tailscale network
LOCAL_ONLY=1
POD_NETWORK_MODE=service:local-net
COMPOSE_PROFILES=local

T3CODE_DESKTOP_VARIANT=local-staging
CONVEX_REV=latest
TAILSCALE_REV=latest

# t3-stack / t3-desktop image base (Debian bookworm default; try node:24-trixie-slim for Debian testing)
POD_BASE_IMAGE=node:24-bookworm-slim
