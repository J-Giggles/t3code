{
	admin off
	auto_https off
}

:8080 {
	handle /healthz {
		respond "ok" 200
	}

	handle_path /convex/* {
		reverse_proxy 127.0.0.1:3210
	}

	handle_path /dashboard/* {
		reverse_proxy 127.0.0.1:6791
	}

	handle_path /vnc/* {
		reverse_proxy 127.0.0.1:{$NOVNC_PORT:6080}
	}

	handle /projects/* {
		reverse_proxy 127.0.0.1:{$DEV_PROXY_PORT:8090} {
			transport http {
				versions 1.1 2
			}
		}
	}

	handle /cdp/* {
		reverse_proxy 127.0.0.1:{$CDP_PORT:9232}
	}

	handle {
		reverse_proxy 127.0.0.1:{$WEB_PORT:6657} {
			header_up Host 127.0.0.1:{$WEB_PORT:6657}
		}
	}
}

# Dynamic dev server proxy (dev-manager can replace routes via mounted snippet file)
:8090 {
	respond "no dev servers" 404
}
