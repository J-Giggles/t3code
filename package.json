{
  "name": "t3code-local-workspace",
  "private": true,
  "description": "Omarchy workspace root (t3code-local/) — Walker-equivalent desktop launchers",
  "packageManager": "pnpm@10.24.0",
  "workspaces": [
    "local-dev-bundle/*"
  ],
  "scripts": {
    "dev": "bash .agents/scripts/t3-start.sh dev",
    "start:main": "bash .agents/scripts/t3-start.sh main",
    "start:staging": "bash .agents/scripts/t3-start.sh staging",
    "start:dev": "bash .agents/scripts/t3-start.sh dev",
    "t3code": "bash .agents/scripts/t3-start.sh main",
    "t3code:staging": "bash .agents/scripts/t3-start.sh staging",
    "t3code:dev": "bash .agents/scripts/t3-start.sh dev",
    "install:launchers": "bash .agents/scripts/t3-start.sh --install-launchers",
    "bootstrap": "bash .agents/scripts/bootstrap-worktrees.sh",
    "kill": "node t3code-staging/scripts/kill-local-desktop-stacks.ts all",
    "kill:main": "node t3code-staging/scripts/kill-local-desktop-stacks.ts main",
    "kill:staging": "node t3code-staging/scripts/kill-local-desktop-stacks.ts staging",
    "kill:dev": "node t3code-staging/scripts/kill-local-desktop-stacks.ts dev",
    "apps": "bash .agents/scripts/t3-convex-docker.sh apps t3code-main",
    "apps:main": "bash .agents/scripts/t3-convex-docker.sh apps t3code-main",
    "apps:staging": "bash .agents/scripts/t3-convex-docker.sh apps t3code-staging",
    "pod:up": "bash .agents/scripts/t3-convex-docker.sh start-all",
    "pod:open": "bash .agents/scripts/t3-convex-docker.sh open all",
    "pod:open:main": "bash .agents/scripts/t3-convex-docker.sh open t3code-main",
    "pod:down": "bash .agents/scripts/t3-convex-docker.sh down all",
    "pod:health": "bash .agents/scripts/t3-convex-docker.sh health all",
    "pod:pair": "bash .agents/scripts/t3-convex-docker.sh bootstrap-pairing-url t3code-staging",
    "pod:pair:main": "bash .agents/scripts/t3-convex-docker.sh bootstrap-pairing-url t3code-main"
  }
}
