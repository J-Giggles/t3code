  "replayContract": {
    "autonomy": "guarded-auto-repair",
    "risk": "medium",
    "intent": "Rebuild local topics on current upstream without routine human intervention, preserve each feature contract, machine-check the result, and use Linear only for promotion review or fundamental product decisions.",
    "preserve": [
      "Preserve the local feature goal: Make local topic replay harder to silently regress by requiring behavior-level README checklists and a run-specific replay audit artifact.",
      "Keep documented owned paths and integration points aligned with local-plugins/topic-replay-safeguards/README.md.",
      "Keep replay contracts explicit enough for an autonomous repair worker to preserve feature intent instead of blindly preferring either side of a file conflict.",
      "Keep completed-stack verification, exact conflict-memory reuse, dependency-floor reconciliation, control-plane sync, and Linear run evidence fail closed."
    ],
    "safeAutoRepair": [
      "Adapt replay checklist validation, audit artifacts, and manifest checks to upstream script/test refactors.",
      "Preserve machine-enforced topic documentation and replay evidence requirements through new metadata shapes.",
      "Repair routine source, test, documentation, and dependency conflicts inside declared topic paths when the replay contract still has one unambiguous implementation.",
      "Reuse a prior repair only when the topic commit and canonical conflict-stage fingerprint match exactly.",
      "When dependency manifests and pnpm-lock.yaml conflict, preserve newer upstream dependency versions and regenerate lock data from the current manifests; never downgrade a manifest merely to match an older topic lockfile."
    ],
    "stopForHuman": [
      "Stop when the topic metadata contract itself needs a new policy decision.",
      "Stop when a repair would loosen promotion, checklist, audit, security, or operator safeguards.",
      "Stop when preserving the local feature requires a product, architecture, security, or operator decision with more than one materially different valid outcome."
    ],
    "verification": [
      "vp check",
      "vp run typecheck",
      "pnpm run topic-plugins:check",
      "vp test run scripts/lib/linear-nightly-control.test.ts scripts/nightly-upstream-agent.test.ts scripts/lib/local-topic-stack.test.ts scripts/lib/nightly-topic-stack.test.ts scripts/lib/nightly-dependency-reconciliation.test.ts"
    ]
  }
